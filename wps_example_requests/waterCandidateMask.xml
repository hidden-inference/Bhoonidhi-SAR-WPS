<?xml version="1.0" encoding="UTF-8"?>
<!-- Mark possible water pixels in the bounding box -->
<wps:Execute service="WPS" version="1.0.0" xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1">
  <ows:Identifier>waterCandidateMask</ows:Identifier>
  <wps:DataInputs>
    <!-- bounding box as lon lat: lower-left corner, then upper-right corner -->
    <wps:Input>
      <ows:Identifier>bbox</ows:Identifier>
      <wps:Data><wps:BoundingBoxData crs="urn:ogc:def:crs:OGC:1.3:CRS84" dimensions="2">
        <ows:LowerCorner>91.8189 22.0610</ows:LowerCorner>
        <ows:UpperCorner>91.9189 22.1610</ows:UpperCorner>
      </wps:BoundingBoxData></wps:Data>
    </wps:Input>
    <wps:Input><ows:Identifier>date</ows:Identifier><wps:Data><wps:LiteralData>2023-05-30</wps:LiteralData></wps:Data></wps:Input>
    <!-- HH, HV or DH (DH = both) -->
    <wps:Input><ows:Identifier>polarization</ows:Identifier><wps:Data><wps:LiteralData>DH</wps:LiteralData></wps:Data></wps:Input>
    <!-- scene id, see http://localhost:5000/scenes -->
    <wps:Input><ows:Identifier>scene_id</ows:Identifier><wps:Data><wps:LiteralData>E04_SAR_MRS_30MAY2023_150235112470_7121_STUC00ZTD_8466_10_DH_D_R_N22565_E091864</wps:LiteralData></wps:Data></wps:Input>
    <!-- pixels darker than this (dB) become water, default -20 -->
    <wps:Input><ows:Identifier>threshold_db</ows:Identifier><wps:Data><wps:LiteralData>-20</wps:LiteralData></wps:Data></wps:Input>
  </wps:DataInputs>
  <!-- the answer contains a download link for the result ZIP -->
  <wps:ResponseForm>
    <wps:ResponseDocument>
      <wps:Output asReference="true"><ows:Identifier>result</ows:Identifier></wps:Output>
    </wps:ResponseDocument>
  </wps:ResponseForm>
</wps:Execute>
