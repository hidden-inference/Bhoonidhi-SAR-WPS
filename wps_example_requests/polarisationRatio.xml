<?xml version="1.0" encoding="UTF-8"?>
<!-- HV/HH ratio for the bounding box (uses both channels) -->
<wps:Execute service="WPS" version="1.0.0" xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1">
  <ows:Identifier>polarisationRatio</ows:Identifier>
  <wps:DataInputs>
    <!-- bounding box as lon lat: lower-left corner, then upper-right corner -->
    <wps:Input>
      <ows:Identifier>bbox</ows:Identifier>
      <wps:Data><wps:BoundingBoxData crs="urn:ogc:def:crs:OGC:1.3:CRS84" dimensions="2">
        <ows:LowerCorner>81.9912 16.6741</ows:LowerCorner>
        <ows:UpperCorner>82.0912 16.7741</ows:UpperCorner>
      </wps:BoundingBoxData></wps:Data>
    </wps:Input>
    <wps:Input><ows:Identifier>date</ows:Identifier><wps:Data><wps:LiteralData>2022-10-21</wps:LiteralData></wps:Data></wps:Input>
    <!-- scene id, see http://localhost:5000/scenes -->
    <wps:Input><ows:Identifier>scene_id</ows:Identifier><wps:Data><wps:LiteralData>E04_SAR_CRS_21OCT2022_294120739036_3773_STUC00ZTD_3790_1_DH_A_L_N16305_E082876</wps:LiteralData></wps:Data></wps:Input>
  </wps:DataInputs>
  <!-- the answer contains a download link for the result ZIP -->
  <wps:ResponseForm>
    <wps:ResponseDocument>
      <wps:Output asReference="true"><ows:Identifier>result</ows:Identifier></wps:Output>
    </wps:ResponseDocument>
  </wps:ResponseForm>
</wps:Execute>
