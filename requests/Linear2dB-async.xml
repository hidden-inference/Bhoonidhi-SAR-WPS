<?xml version="1.0" encoding="UTF-8"?>
<!-- Same as Linear2dB but async: we get a status link and open it again and again until it is done -->
<wps:Execute service="WPS" version="1.0.0" xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1">
  <ows:Identifier>Linear2dB</ows:Identifier>
  <wps:DataInputs>
    <!-- the box I want, as lon lat (lower-left corner, then upper-right corner) -->
    <wps:Input>
      <ows:Identifier>bbox</ows:Identifier>
      <wps:Data><wps:BoundingBoxData crs="urn:ogc:def:crs:OGC:1.3:CRS84" dimensions="2">
        <ows:LowerCorner>76.7054 21.2077</ows:LowerCorner>
        <ows:UpperCorner>76.8054 21.3077</ows:UpperCorner>
      </wps:BoundingBoxData></wps:Data>
    </wps:Input>
    <!-- date of the scene -->
    <wps:Input><ows:Identifier>date</ows:Identifier><wps:Data><wps:LiteralData>2022-05-08</wps:LiteralData></wps:Data></wps:Input>
    <!-- HH, HV or DH (DH = both) -->
    <wps:Input><ows:Identifier>polarization</ows:Identifier><wps:Data><wps:LiteralData>DH</wps:LiteralData></wps:Data></wps:Input>
    <!-- scene id (see /scenes) -->
    <wps:Input><ows:Identifier>scene_id</ows:Identifier><wps:Data><wps:LiteralData>E04_SAR_CRS_08MAY2022_128125859021_1264_STUC00ZTD_1008_13_DH_A_R_N21369_E076607</wps:LiteralData></wps:Data></wps:Input>
  </wps:DataInputs>
  <!-- give me a download link for the ZIP -->
  <wps:ResponseForm>
    <wps:ResponseDocument storeExecuteResponse="true" status="true">
      <wps:Output asReference="true"><ows:Identifier>result</ows:Identifier></wps:Output>
    </wps:ResponseDocument>
  </wps:ResponseForm>
</wps:Execute>
